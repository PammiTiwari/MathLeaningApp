# ---------------------------------------------------------------
# Himmat Rakh - environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------

# Google Gemini powers the AI doubt solver.
# Free key, no card needed: https://aistudio.google.com/apikey
#
# Without a key everything else still works: lessons, notes, videos,
# the formula sheet and the board papers. Only "Doubt pucho" needs it.
#
# Note: the free tier allows 20 requests per model per DAY, so the app
# rotates across several models to stretch that. For more than one user,
# enable billing in Google AI Studio.
GEMINI_API_KEY=

# Optional: pin a specific model instead of the built-in rotation.
# GEMINI_MODEL=

# ---------------------------------------------------------------
# Login (one shared account)
# ---------------------------------------------------------------
# These defaults are what the login page shows on its one-tap button.
# Change them for a real deployment.
AUTH_USER=arnav
AUTH_PASS=123

# Any long random string. Signs the session cookie, so a cookie from one
# deployment cannot be reused on another. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
